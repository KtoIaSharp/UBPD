# Значения ниже накладываются поверх дефолтов ESP-IDF при первой сборке.

# ---- Arduino как компонент ----
# setup()/loop() запускает сам arduino-компонент, мы только их реализуем.
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUINO_VARIANT="esp32"
CONFIG_ARDUINO_LOOP_STACK_SIZE=16384
CONFIG_ENABLE_ARDUINO_DEPENDS=y

# Arduino требует тик FreeRTOS ровно 1000 Гц (см. delay() в esp32-hal-misc.c).
CONFIG_FREERTOS_HZ=1000

# 240 МГц: у Arduino-сборки было столько же, иначе проседает отрисовка и BLE.
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# ---- Радио: и BLE, и классический Bluetooth ----
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y

# ---- Флеш и разделы (как схема huge_app в Arduino) ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Размер кода важнее скорости: у нас 3 МБ на приложение ----
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ---- Экономия IRAM ----
# При добавлении SD (sdmmc/fatfs) переполняется iram0_0_seg. Wi-Fi у нас не
# горячий путь, поэтому убираем его оптимизации из IRAM.
CONFIG_ESP32_WIFI_IRAM_OPT=n
CONFIG_ESP32_WIFI_RX_IRAM_OPT=n

# ---- FATFS: длинные имена ----
# Нужны для имён вида ble_names, *.wav, скриптов и т.п. (8.3 не хватает).
CONFIG_FATFS_LFN_HEAP=y
# UTF-8 имена (а не ANSI/OEM cp437): тогда кириллица в названиях песен не
# схлопывается в короткое имя вида NAUTIL~1.WAV.
CONFIG_FATFS_API_ENCODING_UTF_8=y
